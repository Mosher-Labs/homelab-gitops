---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: tplink-sync
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/Mosher-Labs/homelab-gitops.git
    targetRevision: main
    path: apps/tplink-sync/manifests
  destination:
    server: https://kubernetes.default.svc
    namespace: tplink-sync
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
