---
extends: default

rules:
  line-length:
    # A digest-pinned value (image: repo:tag@sha256:<64 hex>) can't be wrapped.
    allow-non-breakable-inline-mappings: true
    ignore:
      - .github/workflows
      - taskfiles/infra/Taskfile.yml
      - apps/*/sealed-secret.yaml
      - apps/*/manifests/sealed-secret.yaml
      - apps/*/manifests/*-sealed-secret.yaml
      - infrastructure/*/manifests/sealed-secret.yaml
      - infrastructure/*/manifests/*-sealed-secret.yaml
